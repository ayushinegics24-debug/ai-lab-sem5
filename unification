def parse_term(s):
    s = s.strip()

    if '(' not in s:
        return s

    name, rest = s.split('(', 1)
    args = []
    current = ""
    depth = 0

    for ch in rest[:-1]:
        if ch == ',' and depth == 0:
            args.append(parse_term(current))
            current = ""
        else:
            if ch == '(':
                depth += 1
            elif ch == ')':
                depth -= 1
            current += ch

    if current.strip():
        args.append(parse_term(current))

    return (name, args)


def is_variable(x):
    return isinstance(x, str) and x.islower()


def substitute(x, subs):
    while isinstance(x, str) and x in subs:
        x = subs[x]

    if isinstance(x, tuple):
        return (x[0], [substitute(a, subs) for a in x[1]])

    return x


def occurs(var, term, subs):
    term = substitute(term, subs)

    if var == term:
        return True

    if isinstance(term, tuple):
        return any(occurs(var, a, subs) for a in term[1])

    return False


def unify(x, y, subs):
    x = substitute(x, subs)
    y = substitute(y, subs)

    if x == y:
        return True

    if is_variable(x):
        if occurs(x, y, subs):
            return False
        subs[x] = y
        return True

    if is_variable(y):
        if occurs(y, x, subs):
            return False
        subs[y] = x
        return True

    if isinstance(x, tuple) and isinstance(y, tuple):
        if x[0] != y[0] or len(x[1]) != len(y[1]):
            return False

        for a, b in zip(x[1], y[1]):
            if not unify(a, b, subs):
                return False

        return True

    return False


e1 = input("Enter first expression: ")
e2 = input("Enter second expression: ")

x = parse_term(e1)
y = parse_term(e2)

subs = {}

if unify(x, y, subs):
    print("\nUnification Successful")
    print("Substitution Set:", subs)
else:
    print("\nUnification Failed")