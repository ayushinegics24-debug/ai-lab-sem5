def negate(literal):
    if literal.startswith('!'):
        return literal[1:]
    return '!' + literal

def resolve(c1, c2):
    result = set()

    for literal in c1:
        opposite = negate(literal)

        if opposite in c2:
            new_clause = (set(c1) | set(c2)) - {
                literal, opposite
            }

            # Ignore tautological clauses
            if any(negate(x) in new_clause for x in new_clause):
                continue

            result.add(frozenset(new_clause))

    return result

def resolution(kb, query):
    clauses = set(frozenset(c) for c in kb)

    # Add negated query
    clauses.add(frozenset([negate(query)]))

    while True:
        new_clauses = set()
        clause_list = list(clauses)

        for i in range(len(clause_list)):
            for j in range(i + 1, len(clause_list)):
                resolvents = resolve(
                    clause_list[i],
                    clause_list[j]
                )

                if frozenset() in resolvents:
                    return True

                new_clauses.update(resolvents)

        if new_clauses.issubset(clauses):
            return False

        clauses.update(new_clauses)

kb = []

n = int(input("Enter number of clauses: "))

for i in range(n):
    clause = input("Enter clause " + str(i+1) + ": ")
    kb.append([x.strip() for x in clause.split('|')])

query = input("Enter query: ").strip()

print("\nApplying Resolution...")

if resolution(kb, query):
    print("Empty Clause Obtained!")
    print("Query is Proved")
else:
    print("Empty Clause Not Obtained")
    print("Query is Not Proved")